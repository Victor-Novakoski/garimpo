# As variáveis que o Garimpo lê. Ele não carrega arquivo .env: exporte no terminal (ou no ~/.bashrc). Nenhum valor real aqui.

# Registro no Postgres (Supabase: botão Connect, URL do Session pooler).
# Sem ela, o Garimpo usa o arquivo local.
GARIMPO_DATABASE_URL=

# Token do dono para a garimpo-api avulsa (32+ caracteres: openssl rand -hex 32).
GARIMPO_API_TOKEN=

# Só para os testes do banco: um Postgres descartável, nunca o do Supabase.
GARIMPO_TEST_DATABASE_URL=

# Só para a nota da IA com -ai api.
ANTHROPIC_API_KEY=

# Opcional: limite maior da API do GitHub na coleta.
GITHUB_TOKEN=
